---
import '../styles/global.css';
import ComparisonDock from '../components/ComparisonDock.astro';
import { IS_APP, SITE_NAME, SITE_TAGLINE, SITE_URL, href } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica (ej. /ranking/panes-de-molde). Por defecto, la ruta actual. */
  canonicalPath?: string;
  noindex?: boolean;
  /** Objetos JSON-LD que se inyectan en <head>. */
  jsonLd?: Record<string, unknown>[];
  ogImage?: string | null;
  /** Barra flotante de comparación (se apaga en /comparar, que tiene su propio selector). */
  compareDock?: boolean;
}

const { title, description, canonicalPath, noindex = false, jsonLd = [], ogImage, compareDock = true } = Astro.props;
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const canonical = `${SITE_URL}${canonicalPath ?? Astro.url.pathname}`;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');

/** `desktop`: solo en la cabecera (la barra inferior móvil tiene 5 espacios). */
const nav: { path: string; label: string; icon: string; desktop?: boolean }[] = [
  { path: '/', label: 'Inicio', icon: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z' },
  { path: '/productos', label: 'Explorar', icon: 'M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM21 21l-4.35-4.35' },
  { path: '/comparar', label: 'Comparar', icon: 'M8 3 4 7l4 4M4 7h16M16 21l4-4-4-4M20 17H4', desktop: true },
  { path: '/escanear', label: 'Escanear', icon: 'M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M7 8v8M10 8v8M13 8v8M17 8v8' },
  { path: '/lista', label: 'Mi lista', icon: 'M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01' },
  { path: '/perfil', label: 'Perfil', icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0' },
];
const mobileNav = nav.filter((item) => !item.desktop);
const footerLinks = [
  { path: '/metodologia', label: 'Metodología y fuentes' },
  { path: '/reformulaciones', label: 'Reformulaciones' },
  { path: '/empresas', label: 'Empresas y datos' },
  { path: '/reportar', label: 'Reportar un error' },
];
const isActive = (p: string) =>
  p === '/' ? path === '/' : p === '/productos' ? path.startsWith('/productos') || path.startsWith('/ranking') : path.startsWith(p);
const navHref = (p: string) => href(p);
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#039855" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!IS_APP && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
  </head>
  <body class="min-h-dvh">
    <header class="border-b border-stone-200 bg-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
        <a href={href('/')} class="flex items-center gap-2 font-extrabold tracking-tight">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-emerald-600 text-white">S</span>
          <span class="text-lg">{SITE_NAME}</span>
        </a>
        <nav class="hidden items-center gap-1 sm:flex" aria-label="Principal">
          {
            nav.map((item) => (
              <a
                href={navHref(item.path)}
                class:list={[
                  'rounded-xl px-3 py-2 text-sm font-medium',
                  isActive(item.path) ? 'bg-emerald-50 text-emerald-800' : 'text-stone-600 hover:bg-stone-100',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 pt-4 pb-12">
      <slot />
    </main>

    <footer class="mx-auto max-w-5xl px-4 pb-28 text-xs text-stone-500 sm:pb-10">
      <nav class="mb-3 flex flex-wrap gap-x-4 gap-y-1" aria-label="Pie de página">
        {footerLinks.map((l) => <a href={href(l.path)} class="font-medium text-stone-600 hover:underline">{l.label}</a>)}
      </nav>
      <p>
        {SITE_NAME} — {SITE_TAGLINE}. Evaluación independiente basada en la Ley 20.606 (MINSAL), la clasificación NOVA y
        evidencia publicada sobre aditivos. Las marcas no pueden pagar por su puntaje. No reemplaza el consejo de un
        profesional de la salud.
      </p>
    </footer>

    {compareDock && <ComparisonDock />}

    <!-- Barra inferior mobile-first -->
    <nav
      class="safe-bottom fixed inset-x-0 bottom-0 z-30 border-t border-stone-200 bg-white/95 backdrop-blur sm:hidden"
      aria-label="Navegación inferior"
    >
      <ul class="grid grid-cols-5">
        {
          mobileNav.map((item) => (
            <li>
              <a
                href={navHref(item.path)}
                class:list={[
                  'flex flex-col items-center gap-0.5 py-2 text-[11px] font-medium',
                  isActive(item.path) ? 'text-emerald-700' : 'text-stone-500',
                ]}
              >
                <span
                  class:list={[
                    'flex items-center justify-center rounded-2xl',
                    item.path === '/escanear' ? 'h-11 w-11 -mt-5 bg-emerald-600 text-white shadow-lg' : 'h-7 w-7',
                  ]}
                >
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d={item.icon} />
                  </svg>
                </span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </body>
</html>
