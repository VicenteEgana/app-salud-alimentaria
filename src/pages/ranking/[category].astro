---
import MainLayout from '../../layouts/MainLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categoryName, getCategory } from '../../lib/categories';
import { getBestValue, getCategoryProducts, getOffers, type Offer } from '../../lib/db';
import { SITE_URL } from '../../lib/site';
import { clp, perUnit } from '../../lib/ui';
import { versusPath } from '../../lib/versus';

const TOP_MIN_SCORE = 65;

const db = Astro.locals.runtime.env.DB;
const categorySlug = Astro.params.category ?? '';
const products = await getCategoryProducts(db, categorySlug);
const category = getCategory(categorySlug);
if (products.length === 0 && !category) return Astro.rewrite('/404');

const [offersByEan, bestValue] = await Promise.all([
  getOffers(db, products.slice(0, 100).map((p) => p.ean)),
  getBestValue(db, categorySlug, TOP_MIN_SCORE, 3),
]);
const offerOf = (ean: string): Offer | undefined => offersByEan.get(ean)?.find((o) => o.available);

Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=604800');

const name = categoryName(categorySlug);
const noun = category?.seoNoun ?? name.toLowerCase();
const headline = category?.seoHeadline ?? `${name}: los más sanos`;
const year = new Date().getFullYear();

const top = products.filter((p) => p.finalScore >= TOP_MIN_SCORE);
const traps = products.filter((p) => p.isFakeHealthy);
const best = products[0];
const worst = products.at(-1);
const worstTrap = traps.at(-1);

const title = `${headline} de Chile (${year}) y los falsos sin sellos`;
const description = best
  ? `Ranking de ${products.length} ${noun} del supermercado: el mejor es ${best.name} (${best.finalScore}/100). ${traps.length} no tienen sellos pero esconden aditivos o edulcorantes.`
  : `Ranking de ${noun} del supermercado chileno según sellos MINSAL, NOVA y aditivos.`;

const faq: { q: string; a: string }[] = [];
if (best) {
  faq.push({
    q: `¿Cuál es el producto más sano de la categoría ${name.toLowerCase()} en Chile?`,
    a: `Según nuestra evaluación, ${best.name} de ${best.brand}, con ${best.finalScore}/100 puntos, ${best.evaluation.minsalSeals.length} sellos MINSAL y clasificación NOVA ${best.evaluation.novaGroup}.`,
  });
}
if (worst && worst !== best) {
  faq.push({
    q: `¿Cuál es el peor evaluado en ${name.toLowerCase()}?`,
    a: `${worst.name} de ${worst.brand}, con ${worst.finalScore}/100 puntos${
      worst.evaluation.hardCapReason ? ` (${worst.evaluation.hardCapReason.toLowerCase()})` : ''
    }.`,
  });
}
faq.push({
  q: `¿Qué es un "falso sin sellos" en ${name.toLowerCase()}?`,
  a: worstTrap
    ? `Un producto sin sellos negros del MINSAL que igual es ultraprocesado y contiene aditivos o edulcorantes. En esta categoría encontramos ${traps.length}; el peor evaluado es ${worstTrap.name} (${worstTrap.finalScore}/100), que contiene ${worstTrap.evaluation.additives.map((a) => a.name.toLowerCase()).join(', ')}.`
    : 'Un producto sin sellos negros del MINSAL que igual es ultraprocesado y contiene aditivos o edulcorantes. Por ahora no hemos detectado ninguno en esta categoría.',
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Ranking de ${noun} más sanos de Chile`,
    numberOfItems: products.length,
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    itemListElement: products.slice(0, 20).map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${p.name} (${p.brand})`,
      url: `${SITE_URL}/producto/${p.slug}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---

<MainLayout title={title} description={description} noindex={products.length === 0} jsonLd={products.length ? jsonLd : []}>
  <nav class="mb-3 text-xs text-stone-500" aria-label="Migas de pan"><a href="/" class="hover:underline">Inicio</a> › Rankings</nav>
  <h1 class="text-2xl leading-tight font-extrabold sm:text-3xl">{headline} de Chile</h1>
  <p class="mt-1 text-stone-600">
    {products.length} productos verificados, evaluados por calidad nutricional, ultraprocesamiento y aditivos.
  </p>

  {
    products.length === 0 && (
      <p class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 text-stone-600">
        Aún no hay productos verificados en esta categoría. ¡Escanea uno en tu próxima compra!
      </p>
    )
  }

  {
    bestValue.length > 0 && (
      <section class="mt-6 rounded-3xl border border-emerald-200 bg-emerald-50 p-5">
        <h2 class="text-lg font-bold text-emerald-900">Más sano y más barato por kilo</h2>
        <p class="text-sm text-emerald-900/80">Puntaje {TOP_MIN_SCORE} o más, ordenados por precio por unidad de medida en Jumbo.</p>
        <ol class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3">
          {bestValue.map(({ product, offer }, i) => (
            <li class="rounded-2xl border border-emerald-200 bg-white p-3">
              <p class="text-xs font-semibold text-emerald-700">#{i + 1} · {perUnit(offer.ppumPrice, offer.ppumUnit)}</p>
              <a href={`/producto/${product.slug}`} class="mt-0.5 line-clamp-2 font-semibold hover:underline">
                {product.name}
              </a>
              <p class="text-xs text-stone-600">
                {product.finalScore}/100 · {clp(offer.price)}
              </p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <div class="mt-6 grid grid-cols-1 gap-8 lg:grid-cols-2">
    {
      products.length > 0 && (
        <section>
          <h2 class="flex items-center gap-2 text-lg font-bold text-emerald-800">
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500" />
            Top más saludables
          </h2>
          <p class="text-sm text-stone-600">Puntaje {TOP_MIN_SCORE} o más.</p>
          {top.length ? (
            <ol class="mt-3 space-y-2">
              {top.map((p, i) => (
                <li>
                  <ProductCard product={p} rank={i + 1} offer={offerOf(p.ean)} />
                </li>
              ))}
            </ol>
          ) : (
            <p class="mt-3 text-sm text-stone-500">Ningún producto de esta categoría alcanza {TOP_MIN_SCORE} puntos todavía.</p>
          )}
        </section>
      )
    }

    {
      products.length > 0 && (
        <section>
          <h2 class="flex items-center gap-2 text-lg font-bold text-violet-800">
            <span class="h-2.5 w-2.5 rounded-full bg-violet-500" />
            La trampa del pasillo: falsos sin sellos
          </h2>
          <p class="text-sm text-stone-600">0 sellos MINSAL, pero ultraprocesados con aditivos o edulcorantes.</p>
          {traps.length ? (
            <ul class="mt-3 space-y-2">
              {traps.map((p) => (
                <li>
                  <ProductCard product={p} offer={offerOf(p.ean)} />
                  {best && best.ean !== p.ean && (
                    <a href={versusPath(best.slug, p.slug)} class="mt-1 block text-right text-xs font-semibold text-emerald-700 hover:underline">
                      Comparar con {best.name} →
                    </a>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-3 text-sm text-stone-500">No detectamos falsos sin sellos en esta categoría.</p>
          )}
        </section>
      )
    }
  </div>

  {
    products.length > 0 && (
      <section class="mt-10">
        <h2 class="text-lg font-bold">Ranking completo</h2>
        <ol class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
          {products.map((p, i) => (
            <li>
              <ProductCard product={p} rank={i + 1} offer={offerOf(p.ean)} />
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="mt-10 rounded-3xl border border-stone-200 bg-white p-5">
    <h2 class="text-lg font-bold">Preguntas frecuentes</h2>
    <dl class="mt-3 space-y-4">
      {
        faq.map(({ q, a }) => (
          <div>
            <dt class="font-semibold">{q}</dt>
            <dd class="mt-1 text-sm text-stone-700">{a}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</MainLayout>
