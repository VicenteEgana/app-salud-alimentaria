---
import MainLayout from '../layouts/MainLayout.astro';
import { href } from '../lib/site';

export const prerender = true;
---

<MainLayout
  title="Mi lista de compras"
  description="Tu lista de compras con el puntaje del carro, alternativas más sanas y alertas cuando un producto cambia su receta."
  canonicalPath="/lista"
  noindex
>
  <div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-extrabold">Mi lista</h1>
    <p class="mt-1 text-sm text-stone-600">Se guarda en este dispositivo. Te avisamos si alguno de estos productos cambia su receta.</p>

    <div id="list-empty" hidden class="mt-6 rounded-3xl border border-dashed border-stone-300 p-6 text-center">
      <p class="font-semibold">Tu lista está vacía</p>
      <p class="mt-1 text-sm text-stone-600">Escanea un producto o abre una ficha y toca "+ Mi lista".</p>
      <a href={href('/escanear')} class="mt-4 inline-flex rounded-2xl bg-emerald-600 px-5 py-3 font-semibold text-white">Ir al escáner</a>
    </div>

    <section id="list-summary" hidden class="mt-5 rounded-3xl bg-stone-900 p-5 text-white">
      <div class="flex items-center gap-4">
        <div id="cart-score"></div>
        <div>
          <p class="text-sm text-stone-300">Puntaje de tu carro</p>
          <p id="cart-stats" class="text-sm"></p>
        </div>
      </div>
      <a
        id="cart-jumbo"
        hidden
        target="_blank"
        rel="noopener"
        class="mt-4 flex items-center justify-center rounded-2xl bg-emerald-500 px-4 py-3 font-semibold text-white"
      >
        Comprar en Jumbo
      </a>
      <p class="mt-2 text-xs text-stone-400">Precios de la tienda en línea al momento de guardar; pueden variar.</p>
    </section>

    <section id="list-changes" hidden class="mt-5 rounded-3xl border border-amber-200 bg-amber-50 p-4">
      <h2 class="font-bold text-amber-900">Cambios de receta en tu lista</h2>
      <ul id="list-changes-items" class="mt-2 space-y-2 text-sm"></ul>
    </section>

    <ul id="list-items" class="mt-5 space-y-3"></ul>
    <p id="list-status" class="mt-3 min-h-5 text-sm text-stone-500" aria-live="polite"></p>
  </div>
</MainLayout>

<script>
  import { loadChangesSeen, loadList, saveChangesSeen, saveList, toSavedItem, type SavedItem } from '../lib/client-store';
  import type { Offer, Product } from '../lib/db';
  import { scoreCircle } from '../lib/product-html';
  import { API_BASE, href } from '../lib/site';
  import { cartUrl } from '../lib/stores/cencosud';
  import { escapeHtml as e } from '../lib/text';
  import { clp, tierStyle } from '../lib/ui';

  const IMPROVE_BELOW = 65;
  const itemsEl = document.getElementById('list-items') as HTMLUListElement;
  const emptyEl = document.getElementById('list-empty') as HTMLDivElement;
  const summaryEl = document.getElementById('list-summary') as HTMLElement;
  const statusEl = document.getElementById('list-status') as HTMLParagraphElement;

  type Alternative = { product: Product; offers: Offer[] };
  const alternatives = new Map<string, Alternative | null>();

  function render() {
    const list = loadList();
    emptyEl.hidden = list.length > 0;
    summaryEl.hidden = list.length === 0;
    if (list.length === 0) {
      itemsEl.innerHTML = '';
      return;
    }

    const units = list.reduce((n, i) => n + i.qty, 0);
    const avg = Math.round(list.reduce((s, i) => s + i.score * i.qty, 0) / units);
    const fakes = list.filter((i) => i.isFakeHealthy).length;
    const withJumbo = list.filter((i) => i.jumboSku);
    const total = withJumbo.reduce((s, i) => s + (i.jumboPrice ?? 0) * i.qty, 0);

    document.getElementById('cart-score')!.innerHTML = scoreCircle(avg, 'h-16 w-16 text-xl', 'inset-[5px]');
    document.getElementById('cart-stats')!.innerHTML =
      `<span class="font-semibold ${tierStyle(avg).text.replace('700', '300')}">${tierStyle(avg).label}</span> · ${units} unidades` +
      (fakes ? ` · <span class="text-violet-300">${fakes} falso(s) sin sellos</span>` : '') +
      (total ? ` · ${clp(total)} en Jumbo` : '');
    const cart = document.getElementById('cart-jumbo') as HTMLAnchorElement;
    cart.hidden = withJumbo.length === 0;
    cart.href = cartUrl('jumbo', withJumbo.map((i) => ({ sku: i.jumboSku!, qty: i.qty })));
    cart.textContent = `Comprar ${withJumbo.length} producto(s) en Jumbo`;

    itemsEl.innerHTML = list
      .map((item) => {
        const alt = alternatives.get(item.ean);
        return `<li class="rounded-2xl border border-stone-200 bg-white p-3" data-ean="${e(item.ean)}">
          <div class="flex items-center gap-3">
            ${scoreCircle(item.score, 'h-12 w-12 text-base', 'inset-[4px]')}
            <a href="${e(href(`/producto/${item.slug}`))}" class="min-w-0 flex-1">
              <p class="truncate text-[11px] font-medium tracking-wide text-stone-500 uppercase">${e(item.brand)}</p>
              <p class="line-clamp-2 font-semibold leading-snug">${e(item.name)}</p>
              <p class="text-xs text-stone-500">${item.jumboPrice ? clp(item.jumboPrice) : ''}${item.isFakeHealthy ? ' · <span class="font-semibold text-violet-700">Falso sin sellos</span>' : ''}</p>
            </a>
            <div class="flex shrink-0 items-center gap-1">
              <button type="button" data-action="dec" class="h-8 w-8 rounded-lg border border-stone-300" aria-label="Quitar uno">−</button>
              <span class="w-6 text-center tabular-nums">${item.qty}</span>
              <button type="button" data-action="inc" class="h-8 w-8 rounded-lg border border-stone-300" aria-label="Agregar uno">+</button>
            </div>
          </div>
          ${
            alt
              ? `<div class="mt-3 flex items-center gap-3 rounded-xl bg-emerald-50 p-2.5 text-sm">
                  ${scoreCircle(alt.product.finalScore, 'h-9 w-9 text-xs', 'inset-[3px]')}
                  <p class="min-w-0 flex-1"><span class="text-xs text-emerald-800">Mejor opción:</span> <a class="font-semibold hover:underline" href="${e(href(`/producto/${alt.product.slug}`))}">${e(alt.product.name)}</a></p>
                  <button type="button" data-action="swap" class="shrink-0 rounded-lg bg-emerald-600 px-2.5 py-1.5 text-xs font-semibold text-white">Reemplazar</button>
                </div>`
              : ''
          }
        </li>`;
      })
      .join('');
  }

  function update(ean: string, fn: (item: SavedItem, list: SavedItem[]) => SavedItem[]) {
    const list = loadList();
    const item = list.find((i) => i.ean === ean);
    if (!item) return;
    saveList(fn(item, list));
    render();
  }

  itemsEl.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-action]');
    const ean = button?.closest<HTMLElement>('[data-ean]')?.dataset.ean;
    if (!button || !ean) return;
    const action = button.dataset.action;
    update(ean, (item, list) => {
      if (action === 'inc') item.qty++;
      if (action === 'dec') item.qty--;
      if (action === 'swap') {
        const alt = alternatives.get(ean);
        if (!alt) return list;
        alternatives.delete(ean);
        return list.map((i) => (i.ean === ean ? toSavedItem(alt.product, alt.offers, i.qty) : i));
      }
      return list.filter((i) => i.qty > 0);
    });
  });

  /** Refresca puntajes y precios desde la API y busca alternativas para lo que tiene puntaje bajo. */
  async function refresh() {
    const list = loadList();
    if (list.length === 0) return;
    try {
      statusEl.textContent = 'Actualizando puntajes y precios…';
      const res = await fetch(`${API_BASE}/api/products?eans=${list.map((i) => i.ean).join(',')}`);
      const { products } = (await res.json()) as { products: { product: Product; offers: Offer[] }[] };
      const fresh = new Map(products.map((p) => [p.product.ean, p]));
      saveList(loadList().map((i) => {
        const f = fresh.get(i.ean);
        return f ? { ...toSavedItem(f.product, f.offers, i.qty), savedAt: i.savedAt } : i;
      }));

      await Promise.all(
        loadList()
          .filter((i) => i.score < IMPROVE_BELOW && !alternatives.has(i.ean))
          .map(async (i) => {
            const r = await fetch(`${API_BASE}/api/alternatives/${i.ean}`);
            const data = r.ok ? ((await r.json()) as { alternatives: Alternative[] }) : { alternatives: [] };
            alternatives.set(i.ean, data.alternatives[0] ?? null);
          }),
      );
      statusEl.textContent = '';
    } catch {
      statusEl.textContent = 'Sin conexión: mostrando los datos guardados.';
    }
    render();
    void checkChanges();
  }

  /** Alertas de reformulación desde la última vez que se revisó. */
  async function checkChanges() {
    const list = loadList();
    if (list.length === 0) return;
    const since = loadChangesSeen() || list.map((i) => i.savedAt.replace('T', ' ').slice(0, 19)).sort()[0] || '';
    try {
      const res = await fetch(`${API_BASE}/api/changes?eans=${list.map((i) => i.ean).join(',')}&since=${encodeURIComponent(since)}`);
      const { changes } = (await res.json()) as {
        changes: { slug: string; name: string; changedAt: string; oldScore: number; newScore: number; summary: { kind: string; text: string }[] }[];
      };
      if (changes.length === 0) return;
      document.getElementById('list-changes')!.hidden = false;
      document.getElementById('list-changes-items')!.innerHTML = changes
        .map(
          (c) => `<li><a class="font-semibold underline" href="${e(href(`/producto/${c.slug}`))}">${e(c.name)}</a>
            <span class="text-amber-800"> · ${c.oldScore} → ${c.newScore}</span><br>${c.summary.map((s) => e(s.text)).join(' · ')}</li>`,
        )
        .join('');
      saveChangesSeen(changes[0]!.changedAt);
    } catch {
      // Sin red: se revisa en la próxima visita.
    }
  }

  render();
  void refresh();
</script>
