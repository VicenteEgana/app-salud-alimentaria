---
import MainLayout from '../layouts/MainLayout.astro';
import { PROFILES } from '../lib/profiles';

export const prerender = true;
---

<MainLayout
  title="Mi perfil: alertas personalizadas"
  description="Activa alertas para celíacos, intolerancia a la lactosa, APLV, veganos, diabetes y niños. Tu perfil se guarda solo en tu dispositivo."
  canonicalPath="/perfil"
  noindex
>
  <div class="mx-auto max-w-lg">
    <h1 class="text-2xl font-extrabold">Mi perfil</h1>
    <p class="mt-1 text-sm text-stone-600">
      Elige lo que te importa y cada ficha y escaneo te mostrará alertas para ti. Se guarda solo en este dispositivo: no
      lo enviamos a ningún servidor.
    </p>

    <form id="profile-form" class="mt-5 space-y-2">
      {
        PROFILES.map((p) => (
          <label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-stone-200 bg-white p-4 has-[:checked]:border-emerald-400 has-[:checked]:bg-emerald-50">
            <input type="checkbox" name="profile" value={p.id} class="mt-1 h-5 w-5 accent-emerald-600" />
            <span>
              <span class="block font-semibold">{p.name}</span>
              <span class="block text-sm text-stone-600">{p.description}</span>
            </span>
          </label>
        ))
      }
    </form>
    <p id="profile-status" class="mt-2 min-h-5 text-sm text-emerald-700" aria-live="polite"></p>

    <section class="mt-8 rounded-2xl border border-stone-200 bg-white p-4">
      <h2 class="font-bold">Escanear sin conexión</h2>
      <p class="mt-1 text-sm text-stone-600">
        Guardamos en tu dispositivo un resumen de los productos verificados para que el escáner funcione en el pasillo
        aunque no haya señal.
      </p>
      <p id="offline-status" class="mt-2 text-sm text-stone-700"></p>
      <button id="offline-refresh" type="button" class="mt-3 rounded-xl border border-stone-300 px-4 py-2 text-sm font-semibold">
        Actualizar ahora
      </button>
    </section>

    <p class="mt-6 text-xs text-stone-500">
      Las alertas son orientativas y se basan en los ingredientes publicados. Si tienes una alergia o una condición médica,
      revisa siempre el envase y sigue las indicaciones de tu profesional de la salud.
    </p>
  </div>
</MainLayout>

<script>
  import { offlinePackInfo, refreshOfflinePack } from '../lib/client-store';
  import { loadProfiles, saveProfiles, type ProfileId } from '../lib/profiles';
  import { API_BASE } from '../lib/site';

  const form = document.getElementById('profile-form') as HTMLFormElement;
  const status = document.getElementById('profile-status') as HTMLParagraphElement;
  const active = new Set(loadProfiles());
  for (const input of form.querySelectorAll<HTMLInputElement>('input[name="profile"]')) {
    input.checked = active.has(input.value as ProfileId);
  }
  form.addEventListener('change', () => {
    const ids = [...form.querySelectorAll<HTMLInputElement>('input[name="profile"]:checked')].map((i) => i.value as ProfileId);
    saveProfiles(ids);
    status.textContent = ids.length ? 'Guardado en este dispositivo.' : 'Sin perfiles activos.';
  });

  const offlineStatus = document.getElementById('offline-status') as HTMLParagraphElement;
  const offlineButton = document.getElementById('offline-refresh') as HTMLButtonElement;
  const paintOffline = () => {
    const info = offlinePackInfo();
    offlineStatus.textContent = info
      ? `${info.count} productos guardados el ${new Date(info.savedAt).toLocaleDateString('es-CL')}.`
      : 'Todavía no hay productos guardados.';
  };
  paintOffline();
  offlineButton.addEventListener('click', async () => {
    offlineButton.disabled = true;
    offlineStatus.textContent = 'Descargando…';
    await refreshOfflinePack(API_BASE, true);
    paintOffline();
    offlineButton.disabled = false;
  });
</script>
