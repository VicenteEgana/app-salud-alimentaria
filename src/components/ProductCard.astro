---
/**
 * Tarjeta de producto. El HTML sale de productCardHtml (src/lib/product-html.ts), el mismo que usan el
 * catálogo y los buscadores en el navegador, para que ambas versiones nunca se desalineen.
 */
import { toSummary } from '../lib/catalog';
import type { Offer, Product } from '../lib/db';
import { productCardHtml } from '../lib/product-html';

interface Props {
  product: Product;
  /** Posición en un ranking (1, 2, 3…). */
  rank?: number;
  /** Precio a mostrar (ej. la oferta de Jumbo). */
  offer?: Offer;
  /** Botón "+ Comparar" (por defecto sí). */
  compare?: boolean;
}

const { product, rank, offer, compare = true } = Astro.props;
---

<Fragment set:html={productCardHtml(toSummary(product), { rank, offer, compare })} />
