---
import type { Offer, Product } from '../lib/db';
import { NOVA_LABELS } from '../lib/scorer';
import { href } from '../lib/site';
import { NOVA_BADGE, clp, perUnit } from '../lib/ui';
import MinsalSeals from './MinsalSeals.astro';
import ScoreCircle from './ScoreCircle.astro';

interface Props {
  product: Product;
  /** Posición en un ranking (1, 2, 3…). */
  rank?: number;
  /** Precio a mostrar (ej. la oferta de Jumbo). */
  offer?: Offer;
}

const { product, rank, offer } = Astro.props;
const { evaluation } = product;
---

<a
  href={href(`/producto/${product.slug}`)}
  class="group flex min-w-0 items-center gap-3 rounded-2xl border border-stone-200 bg-white p-3 shadow-sm transition hover:border-stone-300 hover:shadow-md"
>
  {rank !== undefined && <span class="w-5 shrink-0 text-center text-sm font-semibold text-stone-400 tabular-nums">{rank}</span>}
  {
    product.imageUrl ? (
      <img src={product.imageUrl} alt="" loading="lazy" decoding="async" class="h-14 w-14 shrink-0 rounded-xl bg-stone-100 object-contain" />
    ) : (
      <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-stone-100 text-lg font-bold text-stone-400">
        {product.name.charAt(0)}
      </div>
    )
  }
  <div class="min-w-0 flex-1">
    <p class="truncate text-xs font-medium tracking-wide text-stone-500 uppercase">{product.brand}</p>
    <h3 class="line-clamp-2 leading-snug font-semibold text-stone-900 group-hover:underline">{product.name}</h3>
    <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
      <span class:list={['rounded-full px-2 py-0.5 text-[11px] font-semibold', NOVA_BADGE[evaluation.novaGroup]]} title={NOVA_LABELS[evaluation.novaGroup]}>
        NOVA {evaluation.novaGroup}
      </span>
      {
        product.isFakeHealthy && (
          <span class="rounded-full bg-violet-600 px-2 py-0.5 text-[11px] font-semibold text-white">Falso sin sellos</span>
        )
      }
      {!product.verified && <span class="rounded-full bg-stone-200 px-2 py-0.5 text-[11px] font-medium text-stone-700">Pendiente</span>}
    </div>
    {evaluation.minsalSeals.length > 0 && <div class="mt-1.5"><MinsalSeals seals={evaluation.minsalSeals} size="sm" /></div>}
    {
      offer && (
        <p class="mt-1 text-xs text-stone-600 tabular-nums">
          {clp(offer.price)} · {perUnit(offer.ppumPrice, offer.ppumUnit)}
        </p>
      )
    }
  </div>
  <ScoreCircle score={product.finalScore} size="md" />
</a>
