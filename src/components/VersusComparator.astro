---
import { toCompareItem } from '../lib/compare';
import type { Product } from '../lib/db';
import { ADDITIVE_LEVEL_LABELS, NOVA_LABELS, type Nutrients } from '../lib/scorer';
import { href } from '../lib/site';
import { formatNumber } from '../lib/text';
import { ADDITIVE_LEVEL_STYLE, NOVA_BADGE, tierStyle } from '../lib/ui';
import MinsalSeals from './MinsalSeals.astro';
import ScoreCircle from './ScoreCircle.astro';

interface Props {
  a: Product;
  b: Product;
}

const { a, b } = Astro.props;
const sides = [a, b] as const;

type Winner = 0 | 1 | null;
/** Índice del ganador de la fila; null si empatan. */
function winner(va: number, vb: number, better: 'lower' | 'higher'): Winner {
  if (va === vb) return null;
  return (better === 'lower' ? va < vb : va > vb) ? 0 : 1;
}

const nutrientRows: { key: keyof Nutrients; label: string; unit: string; better: 'lower' | 'higher' }[] = [
  { key: 'calories', label: 'Calorías', unit: 'kcal', better: 'lower' },
  { key: 'sugars', label: 'Azúcares', unit: 'g', better: 'lower' },
  { key: 'saturatedFat', label: 'Grasas saturadas', unit: 'g', better: 'lower' },
  { key: 'sodium', label: 'Sodio', unit: 'mg', better: 'lower' },
  { key: 'protein', label: 'Proteínas', unit: 'g', better: 'higher' },
  { key: 'fiber', label: 'Fibra', unit: 'g', better: 'higher' },
];

const pillarRows = [
  { label: 'Calidad nutricional (50 %)', values: sides.map((p) => p.evaluation.nutritionScore) },
  { label: 'Procesamiento NOVA (20 %)', values: sides.map((p) => p.evaluation.novaScore) },
  { label: 'Aditivos (30 %)', values: sides.map((p) => p.evaluation.additivesScore) },
];

const overall = winner(a.finalScore, b.finalScore, 'higher');
const mixedBasis = a.isLiquid !== b.isLiquid;
const versusData = JSON.stringify([toCompareItem(a), toCompareItem(b)]);
---

<div class="overflow-clip rounded-3xl border border-stone-200 bg-white shadow-sm">
  <!-- Cabecera dual fija: nombres y puntajes siempre visibles al hacer scroll -->
  <div id="versus-header" class="sticky top-0 z-20 border-b border-stone-200 bg-white/95 backdrop-blur" data-versus={versusData}>
    <div class="grid grid-cols-2 divide-x divide-stone-200">
      {
        sides.map((p, i) => (
          <div class="flex min-w-0 flex-col items-center gap-2 p-3 text-center sm:items-start sm:text-left">
            <a href={href(`/producto/${p.slug}`)} class="flex min-w-0 flex-col items-center gap-2 sm:flex-row">
              <ScoreCircle score={p.finalScore} size="md" />
              <div class="min-w-0">
                <p class="truncate text-[11px] font-medium tracking-wide text-stone-500 uppercase">{p.brand}</p>
                <p class="line-clamp-2 text-sm leading-snug font-semibold hover:underline">{p.name}</p>
                {overall === i && <p class="mt-0.5 text-xs font-bold text-emerald-700">✓ Mejor opción</p>}
              </div>
            </a>
            <button
              type="button"
              data-swap-side={i}
              aria-expanded="false"
              aria-controls="versus-swap"
              aria-label={`Cambiar ${p.name} por otro producto`}
              class="rounded-full border border-stone-300 bg-white px-3 py-1 text-xs font-semibold text-stone-700 hover:bg-stone-50 aria-expanded:border-emerald-600 aria-expanded:text-emerald-700"
            >
              🔄 Cambiar
            </button>
          </div>
        ))
      }
    </div>
    <!-- Buscador para reemplazar uno de los dos y saltar al nuevo versus -->
    <div id="versus-swap" hidden class="border-t border-stone-200 p-3">
      <div class="mb-2 flex items-center justify-between gap-2">
        <label for="versus-swap-input" id="versus-swap-label" class="text-sm font-semibold"></label>
        <button type="button" id="versus-swap-close" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-lg text-stone-500 hover:bg-stone-100" aria-label="Cerrar buscador">
          ×
        </button>
      </div>
      <input
        id="versus-swap-input"
        type="search"
        placeholder="Busca por nombre, marca o EAN"
        class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-2.5 text-base focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 focus:outline-none"
      />
      <ul id="versus-swap-list" class="mt-2 max-h-[45vh] overflow-y-auto"></ul>
    </div>
  </div>

  <div class="divide-y divide-stone-100">
    <!-- Veredicto -->
    <section class="p-4">
      <h2 class="mb-3 text-sm font-semibold tracking-wide text-stone-500 uppercase">Veredicto</h2>
      <div class="grid grid-cols-2 gap-3">
        {
          sides.map((p) => (
            <div class:list={['rounded-2xl border p-3 text-sm', tierStyle(p.finalScore).soft]}>
              <p class:list={['font-bold', tierStyle(p.finalScore).text]}>{tierStyle(p.finalScore).label}</p>
              {p.isFakeHealthy && <p class="mt-1 font-semibold text-violet-700">Falso sin sellos</p>}
              {p.evaluation.hardCapReason && <p class="mt-1 text-xs text-stone-600">{p.evaluation.hardCapReason}</p>}
            </div>
          ))
        }
      </div>
    </section>

    <!-- Sellos MINSAL vs NOVA -->
    <section class="p-4">
      <h2 class="mb-3 text-sm font-semibold tracking-wide text-stone-500 uppercase">Sellos MINSAL vs. procesamiento real</h2>
      <div class="grid grid-cols-2 gap-3">
        {
          sides.map((p) => (
            <div class="flex flex-col items-start gap-2">
              <MinsalSeals seals={p.evaluation.minsalSeals} showEmpty />
              <span class:list={['rounded-full px-2.5 py-1 text-xs font-semibold', NOVA_BADGE[p.evaluation.novaGroup]]}>
                NOVA {p.evaluation.novaGroup} · {NOVA_LABELS[p.evaluation.novaGroup]}
              </span>
              {p.evaluation.borderlineWarnings.map((w) => (
                <span class="text-xs text-amber-700">⚠ {w}</span>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <!-- Aditivos -->
    <section class="p-4">
      <h2 class="mb-3 text-sm font-semibold tracking-wide text-stone-500 uppercase">Aditivos de riesgo</h2>
      <div class="grid grid-cols-2 gap-3">
        {
          sides.map((p) => (
            <ul class="space-y-2">
              {p.evaluation.additives.length === 0 ? (
                <li class="rounded-xl border border-emerald-200 bg-emerald-50 p-2.5 text-xs font-medium text-emerald-800">
                  Sin aditivos de riesgo
                </li>
              ) : (
                [...p.evaluation.additives]
                  .sort((x, y) => y.level - x.level)
                  .map((ad) => (
                    <li class:list={['rounded-xl border p-2.5 text-xs', ADDITIVE_LEVEL_STYLE[ad.level]]}>
                      <p class="font-semibold">{ad.name}</p>
                      <p class="opacity-80">
                        {ADDITIVE_LEVEL_LABELS[ad.level]} · −{ad.penalty} pts
                      </p>
                    </li>
                  ))
              )}
              {p.evaluation.multiSweetenerPenalty && (
                <li class="text-xs text-violet-700">Mezcla de edulcorantes: −10 pts extra</li>
              )}
            </ul>
          ))
        }
      </div>
    </section>

    <!-- Tabla nutricional -->
    <section class="p-4">
      <h2 class="mb-1 text-sm font-semibold tracking-wide text-stone-500 uppercase">Por cada 100 g / 100 ml</h2>
      {mixedBasis && <p class="mb-2 text-xs text-stone-500">Atención: uno se mide por 100 ml y el otro por 100 g.</p>}
      <dl class="mt-2">
        {
          nutrientRows.map((row) => {
            const win = winner(a.nutrients[row.key], b.nutrients[row.key], row.better);
            return (
              <div class="border-b border-stone-100 py-2 last:border-0">
                <dt class="mb-1 text-center text-xs text-stone-500">{row.label}</dt>
                <dd class="grid grid-cols-2 gap-3 text-center tabular-nums">
                  {sides.map((p, i) => (
                    <span class:list={['rounded-lg py-1 font-semibold', win === i ? 'bg-emerald-50 text-emerald-700' : 'text-stone-800']}>
                      {win === i && '✓ '}
                      {formatNumber(p.nutrients[row.key])} {row.unit}
                    </span>
                  ))}
                </dd>
              </div>
            );
          })
        }
      </dl>
    </section>

    <!-- Puntaje por pilar -->
    <section class="p-4">
      <h2 class="mb-1 text-sm font-semibold tracking-wide text-stone-500 uppercase">Puntaje por pilar</h2>
      <dl class="mt-2">
        {
          pillarRows.map((row) => {
            const win = winner(row.values[0]!, row.values[1]!, 'higher');
            return (
              <div class="border-b border-stone-100 py-2 last:border-0">
                <dt class="mb-1 text-center text-xs text-stone-500">{row.label}</dt>
                <dd class="grid grid-cols-2 gap-3 text-center tabular-nums">
                  {row.values.map((v, i) => (
                    <span class:list={['rounded-lg py-1 font-semibold', win === i ? 'bg-emerald-50 text-emerald-700' : 'text-stone-800']}>
                      {win === i && '✓ '}
                      {v} / 100
                    </span>
                  ))}
                </dd>
              </div>
            );
          })
        }
      </dl>
    </section>
  </div>
</div>

<script>
  import { parseCompareItem, type CompareItem } from '../lib/compare';
  import { attachProductPicker } from '../lib/product-picker';
  import { href } from '../lib/site';
  import { versusPath } from '../lib/versus';

  const header = document.getElementById('versus-header') as HTMLDivElement;
  const panel = document.getElementById('versus-swap') as HTMLDivElement;
  const label = document.getElementById('versus-swap-label') as HTMLLabelElement;
  const input = document.getElementById('versus-swap-input') as HTMLInputElement;
  const list = document.getElementById('versus-swap-list') as HTMLUListElement;
  const buttons = [...header.querySelectorAll<HTMLButtonElement>('[data-swap-side]')];
  const sides = (JSON.parse(header.dataset.versus ?? '[]') as unknown[])
    .map(parseCompareItem)
    .filter((s): s is CompareItem => s !== null);

  /** Lado que se reemplaza (0 o 1); el otro se mantiene como rival. */
  let side: 0 | 1 | null = null;

  function close() {
    side = null;
    panel.hidden = true;
    for (const b of buttons) b.setAttribute('aria-expanded', 'false');
  }

  function open(next: 0 | 1) {
    if (side === next) return close();
    side = next;
    const replaced = sides[next];
    const kept = sides[1 - next];
    label.textContent = `Reemplazar ${replaced?.name ?? 'producto'} (se mantiene ${kept?.name ?? 'el otro'})`;
    for (const [i, b] of buttons.entries()) b.setAttribute('aria-expanded', String(i === next));
    panel.hidden = false;
    input.value = '';
    input.focus();
  }

  attachProductPicker({
    input,
    list,
    inline: true,
    context: () => ({
      category: side === null ? undefined : sides[1 - side]?.categorySlug,
      excludeEans: sides.map((s) => s.ean),
    }),
    onPick: (item) => {
      const kept = side === null ? undefined : sides[1 - side];
      if (!kept) return;
      label.textContent = 'Abriendo la nueva comparación…';
      location.href = href(versusPath(item.slug, kept.slug));
    },
  });

  for (const b of buttons) b.addEventListener('click', () => open(Number(b.dataset.swapSide) === 0 ? 0 : 1));
  document.getElementById('versus-swap-close')!.addEventListener('click', close);
  input.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') close();
  });
</script>
